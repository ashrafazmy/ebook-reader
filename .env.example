# Copy to .env at the repository root. No configuration is required for health.
# Run Voicebox separately; the reader only communicates over HTTP.
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_TIMEOUT_SECONDS=10
VOICEBOX_POLL_SECONDS=2
# Local one-paragraph cap; also bounded by the running Voicebox schema's text limit.
MAX_NARRATION_CHARS=5000
# Maximum cached WAV bytes per narration (100 MiB).
MAX_AUDIO_BYTES=104857600
# Deterministic chapter chunks (also bounded by the Voicebox and paragraph limits).
CHAPTER_CHUNK_CHARS=800
# Maximum assembled chapter WAV bytes (1 GiB; no automatic cache eviction).
MAX_CHAPTER_AUDIO_BYTES=1073741824

# Relative paths resolve from the repository root, regardless of terminal directory.
DATA_DIR=backend/data
# Limits in bytes: upload 20 MiB, expanded archive 100 MiB, each entry 10 MiB.
MAX_UPLOAD_BYTES=20971520
MAX_ARCHIVE_BYTES=104857600
MAX_ARCHIVE_ENTRY_BYTES=10485760
MAX_ARCHIVE_ENTRIES=2000
